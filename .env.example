# Copie para .env (o .env NÃO vai para o git) e preencha.

# --- Banco (dev) ---
DB_USER=cardapio
DB_PASSWORD=troque-esta-senha

# --- JWT ---
# Segredo longo e aleatório (ex.: openssl rand -base64 48)
API_SECURITY_TOKEN_SECRET=troque-por-um-segredo-longo
API_SECURITY_TOKEN_EXPIRATION_HOURS=8
# OFFSET fixo, não ID de região
API_SECURITY_TOKEN_TIMEZONE=-03:00
# true em produção (HTTPS)
API_SECURITY_COOKIE_SECURE=false

# --- CORS: origens do front, separadas por vírgula ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Super Administrador inicial (criado no 1º boot se ainda não existir nenhum) ---
SUPER_ADMIN_EMAIL=admin@cardapio.com
SUPER_ADMIN_SENHA=troque-esta-senha

# --- Supabase Storage ---
# Project Settings > API: URL e service_role key (NUNCA use a service_role no front)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=
# Bucket PÚBLICO (leitura) criado no Supabase
SUPABASE_BUCKET=cardapio-midias

# --- Vídeo ---
VIDEO_DURACAO_MAXIMA_SEGUNDOS=90
